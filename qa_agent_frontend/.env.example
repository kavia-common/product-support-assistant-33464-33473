# PUBLIC_INTERFACE
# Base URL of the backend API for Q&A service. Do not include trailing slash.
# The orchestrator will copy required variables into .env at deploy time.
# Base URL for backend Q&A API (no trailing slash)
REACT_APP_API_BASE_URL=

# Port for CRA dev server. If 3000 is occupied, set to another port to avoid interactive prompts.
# Example: PORT=3001
PORT=3000https://your-backend.example.com
