# Copy this file to ".env" in the same directory to configure local development.
# IMPORTANT: This file is read by Create React App. Place ".env" in this qa_agent_frontend directory.

# Port for the CRA dev server. Use this to avoid interactive prompts and port conflicts.
# Example to serve on port 3002:
# PORT=3002
PORT=3000

# Base URL for a backend Q&A API (optional).
# No trailing slash. If not set, the app uses simulated API in src/utils/api.js.
# REACT_APP_API_BASE_URL=https://your-backend.example.com
